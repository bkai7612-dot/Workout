# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# RevenueCat — Project Settings → API keys (public SDK keys, one per platform)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxx

# RevenueCat entitlement identifier that unlocks Premium
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
