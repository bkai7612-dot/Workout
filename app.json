{
  "expo": {
    "name": "ProjectBuilt",
    "slug": "projectbuilt",
    "scheme": "projectbuilt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0A",
    "splash": {
      "backgroundColor": "#0A0A0A",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.projectbuilt.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.projectbuilt.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      },
      "permissions": ["com.android.vending.BILLING", "VIBRATE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
